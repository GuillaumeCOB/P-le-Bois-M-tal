# Copiez ce fichier en ".streamlit/secrets.toml" pour un test en local
# (ce fichier local ne doit JAMAIS être envoyé sur GitHub — voir .gitignore).
#
# Sur Streamlit Community Cloud, ne créez PAS ce fichier : renseignez ces
# mêmes valeurs dans l'interface web, onglet "Settings" > "Secrets" de votre
# application déployée.

SUPABASE_URL = "https://VOTRE-PROJET.supabase.co"
SUPABASE_KEY = "VOTRE_CLE_SERVICE_ROLE"
